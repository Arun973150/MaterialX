# Copy this file to `.env` and fill in your keys. `.env` is gitignored — never commit real keys.

# Materials Project API key — get one free at https://materialsproject.org (Dashboard -> API key).
# Used by mp-api's MPRester, which reads this variable automatically.
MP_API_KEY=

# Optional: Weights & Biases for experiment tracking (Phases 4-5). Leave blank to use local MLflow.
WANDB_API_KEY=
